# Source this file on the NEW Linux server after replacing paths if necessary.
export FASTH3_HOME=/root/autodl-tmp/fasth3
export PYTHON_BIN=/root/miniconda3/bin/python
export FASTH3_PORT=8091
export DOWNLOAD_ENDPOINT=https://hf-mirror.com
export DOWNLOAD_WORKERS=32
