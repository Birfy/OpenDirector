# Normalize text files to LF in the repository and in the working tree.
* text=auto eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary

# Windows scripts must keep CRLF so cmd.exe parses them correctly.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
