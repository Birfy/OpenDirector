# Normalize text files to LF in the repository and in the working tree.
# On Windows with core.autocrlf=true, the default behaviour rewrites LF to CRLF
# on checkout, which breaks every byte-level SHA-256 check in
# `npm run recovery:check` (research/capture and recovered/ are compared byte
# for byte against the recorded digests).
* text=auto eol=lf

# Captured resources, derived modules and source maps are byte-exact evidence.
# Never apply end-of-line or text conversion to them.
research/capture/** -text
research/prepared/** -text
recovered/modules/** -text
recovered/reports/** -text

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary

# Windows scripts must keep CRLF so cmd.exe parses them correctly.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf